<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>wcr2</AssemblyName>
    <RootNamespace>WzComparerR2.Cli</RootNamespace>
    <IsPublishable>true</IsPublishable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WzComparerR2.WzLib\WzComparerR2.WzLib.csproj" SetTargetFramework="TargetFramework=net8.0" AdditionalProperties="NuGetAudit=false;RestoreIgnoreFailedSources=true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ImageManipulation">
      <HintPath>..\References\ImageManipulation.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\WzComparerR2.Common\Calculator.cs" Link="Common\Calculator.cs" />
    <Compile Include="..\WzComparerR2.Common\GlobalFindNodeFunction.cs" Link="Common\GlobalFindNodeFunction.cs" />
    <Compile Include="..\WzComparerR2.Common\Gif.cs" Link="Common\Gif.cs" />
    <Compile Include="..\WzComparerR2.Common\GifFrame.cs" Link="Common\GifFrame.cs" />
    <Compile Include="..\WzComparerR2.Common\IGifFrame.cs" Link="Common\IGifFrame.cs" />
    <Compile Include="..\WzComparerR2.Common\Wz_NodeExtension2.cs" Link="Common\Wz_NodeExtension2.cs" />
    <Compile Include="..\WzComparerR2.Common\Encoders\BuildInApngEncoder.cs" Link="Common\Encoders\BuildInApngEncoder.cs" />
    <Compile Include="..\WzComparerR2.Common\Encoders\BuildInGifEncoder.cs" Link="Common\Encoders\BuildInGifEncoder.cs" />
    <Compile Include="..\WzComparerR2.Common\Encoders\GifEncoder.cs" Link="Common\Encoders\GifEncoder.cs" />
    <Compile Include="..\WzComparerR2.Common\Encoders\GifEncoderCompatibility.cs" Link="Common\Encoders\GifEncoderCompatibility.cs" />
    <Compile Include="..\WzComparerR2.Common\Encoders\IndexGifEncoder.cs" Link="Common\Encoders\IndexGifEncoder.cs" />
    <Compile Include="..\WzComparerR2\Patcher\WzPatcher.cs" Link="Patcher\WzPatcher.cs" />
    <Compile Include="..\WzComparerR2\Patcher\PatchPartContext.cs" Link="Patcher\PatchPartContext.cs" />
    <Compile Include="..\WzComparerR2\Patcher\PatchingEventArgs.cs" Link="Patcher\PatchingEventArgs.cs" />
    <Compile Include="..\WzComparerR2\Patcher\PatchingState.cs" Link="Patcher\PatchingState.cs" />
    <Compile Include="..\WzComparerR2\Patcher\Builder\BuildInstruction.cs" Link="Patcher\Builder\BuildInstruction.cs" />
    <Compile Include="..\WzComparerR2\Patcher\Builder\BuildType.cs" Link="Patcher\Builder\BuildType.cs" />
    <Compile Include="..\WzComparerR2\Patcher\Builder\CheckSum.cs" Link="Patcher\Builder\CheckSum.cs" />
    <Compile Include="..\WzComparerR2\Patcher\Builder\InflateStream.cs" Link="Patcher\Builder\InflateStream.cs" />
    <Compile Include="..\WzComparerR2\Patcher\Builder\StreamUtils.cs" Link="Patcher\Builder\StreamUtils.cs" />
  </ItemGroup>
</Project>
